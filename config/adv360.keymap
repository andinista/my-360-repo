#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <155>;
        };

        hmsft: homerow_mods_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_SHIFT";
            #binding-cells = <2>;
            tapping-term-ms = <150>; //Orig 200 // Orig: 175
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <125>;
        };

        //
        // Thumb cluster hold-tap keys for Miryoku layers
        //

        thumb: thumb_layer_access {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <155>; // enable repeat
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
        };

        space: thumb_layer_access_spacebar {
            compatible = "zmk,behavior-hold-tap";
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <155>; // enable repeat
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
        };

        //
        // Shift + LEFT_PARENTHESIS = LESS_THAN
        //

        parang_left: left_parenthesis_and_less_than {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp LT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        //
        // Shift + RIGHT_PARENTHESIS = GREATER_THAN
        //

        parang_right: right_parenthesis_and_greater_than {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RPAR>, <&kp GT>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        lt_caps_word: lt_caps_word {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <260>;
            bindings = <&mo>, <&caps_word>;
        };

        macros {
            vim_save: vim_save {
                compatible = "zmk,behavior-macro";
                label = "VIM_SAVE";
                #binding-cells = <0>;
                bindings = <&kp ESCAPE &kp SPACE &kp BSPC &kp LS(SEMI) &kp SPACE &kp BSPC &kp W &kp SPACE &kp BSPC &kp ENTER>;
            };

            pwd: pwd {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                bindings = <&kp A &kp SPACE &kp BACKSPACE &kp B &kp SPACE &kp BACKSPACE &kp DOUBLE_QUOTES &kp SPACE &kp BACKSPACE &kp N1 &kp SPACE &kp BACKSPACE &kp N2 &kp SPACE &kp BACKSPACE &kp N3 &kp SPACE &kp BACKSPACE &kp N4 &kp SPACE &kp BACKSPACE &kp N5 &kp RET>;
                label = "PWD";
            };
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&caps_word         &kp N1          &kp N2           &kp N3          &kp N4       &kp N5  &none                                                                    &mo 3         &kp N6  &kp N7        &kp N8            &kp N9             &kp N0             &kp EQUAL
&kp UNDER          &kp Q           &hm RIGHT_ALT W  &kp E           &kp R        &kp T   &none                                                                    &none         &kp Y   &kp U         &kp I             &hm RIGHT_ALT O    &kp P              &kp MINUS
&lt 6 GRAVE        &hm LEFT_ALT A  &hm LMETA S      &hmsft LSHFT D  &hm LCTRL F  &kp G   &caps_word      &lt 7 ESCAPE        &none           &none    &kp ESCAPE  &caps_word    &kp H   &hm RCTRL J   &hmsft RSHFT K    &hm RMETA L        &hm LEFT_ALT SEMI  &kp SQT
&kp NON_US_BSLH    &kp Z           &space 6 X       &space 6 C      &kp V        &kp B                                       &none           &none                              &kp N   &kp M         &kp COMMA         &space 6 PERIOD    &kp FSLH           &kp NON_US_HASH
&lt_caps_word 2 0  &kp LEFT        &kp DOWN         &kp UP_ARROW    &kp RIGHT            &space 4 SPACE  &thumb 6 BACKSPACE  &caps_word      &kp DEL  &kp RET     &thumb 5 TAB          &parang_left  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &parang_right      &lt_caps_word 2 0
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1    &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans    &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans    &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans    &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&kp CAPS  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &kp CAPS
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        CURSOR {
            bindings = <
&pwd             &kp LC(N1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &kp LC(NUMBER_4)  &kp LC(N5)  &trans                                      &trans  &kp LC(NUMBER_6)  &kp LC(N7)  &kp LC(N8)       &kp LC(N9)         &trans     &vim_save
&trans           &trans      &kp LC(W)         &trans            &kp LC(R)         &trans      &trans                                      &trans  &trans            &trans      &kp LC(PAGE_UP)  &kp LC(PAGE_DOWN)  &pwd       &trans
&trans           &trans      &vim_save         &trans            &trans            &trans      &trans  &trans  &trans      &trans  &trans  &trans  &trans            &kp LEFT    &kp DOWN         &kp UP_ARROW       &kp RIGHT  &caps_word
&trans           &trans      &kp LC(X)         &kp LC(C)         &kp LC(V)         &trans                      &trans      &trans                  &trans            &kp HOME    &kp PAGE_DOWN    &kp PAGE_UP        &kp END    &trans
&kp PRINTSCREEN  &trans      &trans            &trans            &trans                        &trans  &trans  &trans      &trans  &trans  &trans                    &trans      &trans           &trans             &trans     &trans
            >;
        };

        SYMBOL {
            bindings = <
&trans               &trans                &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp SEMI               &kp COMMA     &trans                                      &trans  &trans  &trans  &trans                        &trans                        &trans  &trans
&kp EXCL             &kp LEFT_PARENTHESIS  &kp SINGLE_QUOTE  &kp AT             &kp RIGHT_PARENTHESIS  &kp QUESTION  &trans                                      &trans  &trans  &trans  &kp LS(LA(LC(LG(NUMBER_2))))  &trans                        &trans  &trans
&kp NON_US_HASH      &kp CARET             &kp EQUAL         &kp UNDER          &kp DOLLAR             &kp ASTERISK  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans                        &kp LS(LA(LC(LG(NUMBER_2))))  &trans  &kp LS(LA(LC(LG(NUMBER_2))))
&kp LS(NON_US_BSLH)  &kp LESS_THAN         &kp AMPERSAND     &kp MINUS          &kp GREATER_THAN       &kp PLUS                      &trans      &trans                  &trans  &trans  &trans                        &trans                        &trans  &trans
&kp DOUBLE_QUOTES    &kp NON_US_BSLH       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SLASH                            &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans                        &trans                        &trans  &trans
            >;
        };

        NUMBERS {
            bindings = <
&trans  &trans     &trans  &kp A   &kp B               &kp C   &trans                                                   &trans           &kp DOLLAR       &kp LS(N3)                         &kp COMMA        &kp AMPERSAND    &trans           &trans
&trans  &trans     &kp AT  &kp X   &kp Y               &kp Z   &trans                                                   &trans           &kp PERCENT      &kp KP_NUMBER_7                    &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp LS(SEMI)     &none
&trans  &trans     &trans  &kp X   &hm LEFT_CONTROL Y  &kp Z   &trans          &trans  &trans      &none  &kp KP_DOT    &trans           &kp KP_PLUS      &hm RC(RIGHT_CONTROL) KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_SUBTRACT  &kp DOUBLE_QUOTES
&trans  &kp LS(G)  &trans  &kp K   &kp L               &trans                          &trans      &none                                 &kp KP_ASTERISK  &kp KP_NUMBER_1                    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_DIVIDE    &none
&trans  &trans     &trans  &trans  &trans                      &space 4 SPACE  &trans  &trans      &none  &kp KP_EQUAL  &kp KP_NUMBER_0                   &trans                             &trans           &trans           &trans           &kp CAPS
            >;
        };

        CONTROLS {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                     &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                     &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans      &trans             &trans           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP          &trans  &trans  &trans  &trans  &trans
            >;
        };

        extra1 {
            display-name = "Red";
            status = "reserved";
        };

        extra2 {
            display-name = "Purple";
            status = "reserved";
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };

        extra4 {
            display-name = "Yellow";
            status = "reserved";
        };
    };
};
